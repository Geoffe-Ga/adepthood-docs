{
  // Markdownlint configuration for the Adepthood docs corpus.
  // Prose-pragmatic: structural rules stay on; pure style rules that fight
  // natural writing are relaxed here (configuration, not suppression).
  "config": {
    "default": true,
    // Line length: docs prose and long URLs make a hard wrap limit noisy.
    "MD013": false,
    // Inline HTML: MkDocs Material content occasionally needs it.
    "MD033": false,
    // Duplicate headings allowed when not siblings (e.g. dated changelog
    // files each containing an "## HH:MM UTC" heading).
    "MD024": { "siblings_only": true },
    // Code-block style: Material admonitions (`!!!` / `???`) require a
    // 4-space-indented body, which MD046 cannot distinguish from an indented
    // code block. In "consistent" mode a page that uses both an admonition and
    // a fenced block (e.g. mermaid) is unsatisfiable -- whichever appears first
    // makes the other an error. Relaxed rather than contorting pages around it.
    "MD046": false
  },
  "ignores": ["node_modules/**", "site/**", ".venv/**"]
}
